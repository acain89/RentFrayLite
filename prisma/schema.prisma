generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  SETUP
  ACTIVE
  DISABLED
}

enum CheckoutSessionStatus {
  CREATED
  REVIEWED
  CHECKOUT_STARTED
  PAID
  FAILED
  EXPIRED
  ABANDONED
}

enum SetupStep {
  VERIFY_EMAIL
  CONFIGURE_RECURRING_TIERS
  CONFIGURE_RECURRING_CHARGES
  CONFIGURE_RECURRING_BILLING
  REVIEW_RECURRING
  CONNECT_STRIPE
  CHOOSE_ACCOUNT_CODE
  COMPLETE
}

enum PaymentStatus {
  CREATED
  CHECKOUT_STARTED
  PENDING
  PAID
  FAILED
  EXPIRED
  DISPUTED
  RETURNED
}

enum PaymentMethod {
  ACH
  CARD
}

enum StripeChargeModel {
  LEGACY_DESTINATION
  DIRECT
}

enum PaymentSourceType {
  RECURRING_PLAN
  CUSTOM_PAYMENT
}

enum SessionType {
  MANAGER
  ADMIN
}

enum SmsReceiptStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminAccess {
  id         String    @id @default(cuid())
  codeHash   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sessions Session[]

  @@index([isActive])
}

model Business {
  id                  String         @id @default(cuid())
  name                String
  accountCode         String?        @unique
  accountCodeLockedAt DateTime?
  status              BusinessStatus @default(SETUP)
  setupStep           SetupStep      @default(VERIFY_EMAIL)
  setupCompletedAt    DateTime?

  // Dormant calendar foundation. Null preserves unknown historical configuration.
  // Validate named IANA zones with validatePropertyTimeZone before future writes.
  propertyTimeZone         String?
  // Property-local date, not an instant; Prisma represents SQL DATE at UTC midnight.
  firstStandardBillingDate DateTime? @db.Date

  ownerName    String
  contactEmail String
  contactPhone String?
  paymentSmsEnabled Boolean? @default(true)
  smsConsentAt DateTime?
  smsConsentVersion String?
  smsConsentPhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  manager            Manager?
  stripeConnection   StripeConnection?
  recurringPlans     RecurringPlan[]
  payments           Payment[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  sessions           Session[]

  instantPayoutRequests InstantPayoutRequest[]

  @@index([status])
  @@index([contactEmail])
  @@index([isActive])
}

model Manager {
  id           String    @id @default(cuid())
  businessId   String    @unique
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions Session[]
  instantPayoutRequests InstantPayoutRequest[]

  @@index([email])
  @@index([isActive])
}

model StripeConnection {
  id                  String    @id @default(cuid())
  businessId          String    @unique
  stripeAccountId     String    @unique
  chargesEnabled      Boolean   @default(false)
  payoutsEnabled      Boolean   @default(false)
  onboardingComplete  Boolean   @default(false)
  requirementsDue     Boolean   @default(false)
  requirementsSummary String?
  readyForLive        Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([readyForLive])
  @@index([onboardingComplete])
}

// Durable external-operation journal; retained even if an uncharged business is deleted.
model StripeAccountProvisioning {
  id                      String @id @default(cuid())
  businessId              String @unique
  chargeModel             StripeChargeModel
  stripePlatformAccountId String
  stripeMode              String
  parameters              Json
  stripeAccountId         String? @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CheckoutSession {
  id String @id @default(cuid())

  businessId  String
  accountCode String
  sourceType  PaymentSourceType @default(RECURRING_PLAN)
  planId      String?

  billingCycle String?
  unitNumber   String
  firstName    String
  lastName     String
  phone        String
  smsConsentAt DateTime?
  smsConsentVersion String?

  paymentMethod PaymentMethod

  baseAmountCents       Int
  recurringChargesCents Int
  initialLateFeeCents   Int
  dailyLateFeesCents    Int
  subtotalCents         Int
  platformFeeCents      Int
  totalCents            Int

  // subtotalCents is management owed; platformFeeCents is the tenant fee.
  // Nullable for historical records: never infer account/version from current configuration.
  pricingVersion                    String?
  chargeModel                       StripeChargeModel?
  stripeConnectedAccountId          String?
  // Unknown historical platform/environment facts remain NULL.
  stripePlatformAccountId           String?
  stripeMode                        String?
  expectedStripeProcessingFeeCents   Int?
  rflApplicationFeeCents             Int?
  expectedManagementNetCents         Int?

  lineItems        Json

  dueDate     DateTime?
  graceEndsAt DateTime?

  status CheckoutSessionStatus @default(CREATED)

  stripeCheckoutSessionId String? @unique
  paymentId               String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([accountCode])
  @@index([planId])
  @@index([billingCycle])
  @@index([status])
  @@index([expiresAt])
  @@index([businessId, unitNumber, billingCycle])
}

model RecurringPlan {
  id                  String   @id @default(cuid())
  businessId          String
  name                String
  baseAmountCents     Int
  dueDay              Int
  gracePeriodDays     Int      @default(1)
  initialLateFeeCents Int      @default(0)
  dailyLateFeeCents   Int      @default(0)
  dailyLateFeeMaxDays Int      @default(0)
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  charges  RecurringCharge[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, isActive])
}

model RecurringCharge {
  id                    String   @id @default(cuid())
  recurringPlanId       String
  sharedChargeGroupId   String?
  label                 String
  amountCents           Int
  effectiveBillingCycle String?
  endsAfterBillingCycle String?
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recurringPlan RecurringPlan @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)

  @@index([recurringPlanId, isActive])
  @@index([recurringPlanId, sortOrder])
  @@index([sharedChargeGroupId])
  @@index([effectiveBillingCycle])
  @@index([endsAfterBillingCycle])
}

model Payment {
  id         String            @id @default(cuid())
  // New attempts only. Historical identity is never inferred from payer/unit/month.
  checkoutAttemptId String?     @unique
  businessId String
  sourceType PaymentSourceType
  sourceId   String?

  status        PaymentStatus  @default(CREATED)
  paymentMethod PaymentMethod?

  payerFirstName String
  payerLastName  String
  payerPhone     String
  payerEmail     String?
  referenceLabel String?

  itemDescription       String
  lineItemsSnapshot     Json
  subtotalCents         Int
  platformFeeCents      Int
  processorFeeCents     Int?
  totalChargedCents     Int
  businessProceedsCents Int?

  // businessProceedsCents remains expected management net, not observed net.
  // processorFeeCents is reserved for observed Stripe processing costs.
  pricingVersion                    String?
  chargeModel                       StripeChargeModel?
  stripeConnectedAccountId          String?
  stripePlatformAccountId           String?
  stripeMode                        String?
  expectedStripeProcessingFeeCents   Int?
  rflApplicationFeeCents             Int?
  stripeBalanceTransactionId        String?
  actualManagementNetCents           Int?

  billingCycle String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String? @unique

  checkoutStartedAt DateTime?
  pendingAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  expiredAt         DateTime?
  disputedAt        DateTime?
  returnedAt        DateTime?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  smsReceipt     SmsReceipt?
  smsNotifications SmsNotification[]
  financialReconciliation DirectFinancialReconciliation?
  customerRefunds CustomerRefundObservation[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, billingCycle])
  @@index([businessId, sourceType, sourceId])
  @@index([status, createdAt])
}

// Provider observations only: no refund initiation, principal allocation or backfill.
model CustomerRefundObservation {
  id String @id @default(cuid())
  paymentId String
  stripeRefundId String
  stripePlatformAccountId String
  stripeAccountId String
  stripeMode String
  chargeModel StripeChargeModel?
  pricingVersion String?
  stripeChargeId String
  stripePaymentIntentId String
  amountCents Int
  currency String
  status String
  stripeCreatedAt DateTime
  observedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([stripePlatformAccountId, stripeAccountId, stripeMode, stripeRefundId], map: "CustomerRefund_scope_identity_key")
  @@index([paymentId, status])
}

model SmsReceipt {
  id                String           @id @default(cuid())
  paymentId         String           @unique
  phone             String
  status            SmsReceiptStatus @default(QUEUED)
  providerMessageId String?          @unique
  failureMessage    String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Short-lived public API counters, independent of tenant and financial records.
model PublicRequestBudget {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model VerificationToken {
  id         String                @id @default(cuid())
  businessId String
  type       VerificationTokenType
  tokenHash  String                @unique
  // PASSWORD_RESET only; NULL historical tokens never authorize recovery.
  credentialFingerprint String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type])
  @@index([expiresAt])
  @@index([type, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorType  String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([action, targetId, createdAt])
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  type      SessionType

  businessId    String?
  managerId     String?
  adminAccessId String?

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager     Manager?     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  adminAccess AdminAccess? @relation(fields: [adminAccessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([managerId])
  @@index([adminAccessId])
  @@index([type, expiresAt])
  @@index([expiresAt])
}

// One durable operation per direct payment; no legacy backfill or financial repricing.
enum DirectReconciliationStatus {
  WAITING_DATA
  REQUIRED
  CORRECTED
  RECONCILED
  EXCEPTION
}

model DirectFinancialReconciliation {
  id String @id @default(cuid())
  paymentId String @unique
  status DirectReconciliationStatus @default(WAITING_DATA)
  reasonCode String?
  refreshRequested Boolean @default(false)
  expectedSnapshot Json
  initialObservation Json?
  latestObservation Json?
  applicationFeeId String? @unique
  actualProcessorFeeCents Int?
  observedManagementNetCents Int?
  correctionCents Int @default(0)
  confirmedCorrectionCents Int @default(0)
  unresolvedShortfallCents Int?
  idempotencyKey String? @unique
  reservedAt DateTime?
  stripeRefundId String? @unique
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([status, updatedAt])
}

// Transition outbox. Historical SmsReceipt rows remain intact and are not consent evidence.
model SmsNotification {
  id String @id @default(cuid())
  paymentId String
  transitionKey String
  recipientType String
  eventType String
  paymentState String
  phone String
  phoneHash String
  body String
  consentVersion String?
  consentAt DateTime?
  status String @default("QUEUED")
  reasonCode String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  claimedAt DateTime?
  providerMessageId String? @unique
  callbackToken String @unique
  sentAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([paymentId, recipientType, transitionKey])
  @@index([status, nextAttemptAt])
  @@index([phoneHash, status])
}

// Sparse, program-wide opt-out suppression; never a tenant profile.
model SmsSuppression {
  phoneHash String @id
  reasonCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dormant payout journal, separate from immutable tenant payments. No backfill.
model InstantPayoutRequest {
  id String @id
  businessId String
  managerId String
  authorizationSessionId String
  platformAccountId String
  connectedAccountId String
  stripeMode String
  destinationId String
  currency String @default("usd")
  pricingVersion String
  selectedAmountCents Int
  rflFeeCents Int
  expectedReceivedCents Int
  eligibleFundsCents Int
  evidenceReference String
  evidenceObservedAt DateTime
  idempotencyKey String @unique
  stripePayoutId String? @unique
  status String @default("RESERVED")
  errorCode String?
  lastObservedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  manager Manager @relation(fields: [managerId], references: [id], onDelete: Restrict)
  @@index([businessId, createdAt])
}
