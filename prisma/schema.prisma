generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OneTimeChargeStatus {
  PENDING
  PAID
  CANCELLED
}

enum BusinessStatus {
  SETUP
  ACTIVE
  DISABLED
}

enum CheckoutSessionStatus {
  CREATED
  REVIEWED
  CHECKOUT_STARTED
  PAID
  FAILED
  EXPIRED
  ABANDONED
}

enum SetupStep {
  VERIFY_EMAIL
  CONFIGURE_RECURRING_TIERS
  CONFIGURE_RECURRING_CHARGES
  CONFIGURE_RECURRING_BILLING
  REVIEW_RECURRING
  CONNECT_STRIPE
  CHOOSE_ACCOUNT_CODE
  COMPLETE
}

enum PaymentStatus {
  CREATED
  CHECKOUT_STARTED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  DISPUTED
  RETURNED
}

enum PaymentMethod {
  ACH
  CARD
}

enum PaymentSourceType {
  RECURRING_PLAN
  CATALOG_ITEM
  CUSTOM_POSTING
}

enum SessionType {
  MANAGER
  ADMIN
}

enum SmsReceiptStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminAccess {
  id         String    @id @default(cuid())
  codeHash   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sessions Session[]

  @@index([isActive])
}

model Business {
  id                  String         @id @default(cuid())
  name                String
  accountCode         String?        @unique
  accountCodeLockedAt DateTime?
  status              BusinessStatus @default(SETUP)
  setupStep           SetupStep      @default(VERIFY_EMAIL)
  setupCompletedAt    DateTime?

  ownerName    String
  contactEmail String
  contactPhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  manager            Manager?
  stripeConnection   StripeConnection?
  recurringPlans     RecurringPlan[]
  payments           Payment[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  sessions           Session[]
  oneTimeCharges     OneTimeCharge[]

  @@index([status])
  @@index([contactEmail])
  @@index([isActive])
}

model Manager {
  id           String    @id @default(cuid())
  businessId   String    @unique
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([email])
  @@index([isActive])
}

model StripeConnection {
  id                  String    @id @default(cuid())
  businessId          String    @unique
  stripeAccountId     String    @unique
  chargesEnabled      Boolean   @default(false)
  payoutsEnabled      Boolean   @default(false)
  onboardingComplete  Boolean   @default(false)
  requirementsDue     Boolean   @default(false)
  requirementsSummary String?
  readyForLive        Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([readyForLive])
  @@index([onboardingComplete])
}

model CheckoutSession {
  id String @id @default(cuid())

  businessId  String
  accountCode String
  planId      String

  billingCycle String
  unitNumber   String
  firstName    String
  lastName     String
  phone        String

  paymentMethod PaymentMethod

  baseAmountCents       Int
  recurringChargesCents Int
  initialLateFeeCents   Int
  dailyLateFeesCents    Int
  subtotalCents         Int
  platformFeeCents      Int
  totalCents            Int

  lineItems Json

  dueDate     DateTime
  graceEndsAt DateTime

  status CheckoutSessionStatus @default(CREATED)

  stripeCheckoutSessionId String? @unique
  paymentId               String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([accountCode])
  @@index([planId])
  @@index([billingCycle])
  @@index([status])
  @@index([expiresAt])
  @@index([businessId, unitNumber, billingCycle])
}

model RecurringPlan {
  id                  String   @id @default(cuid())
  businessId          String
  name                String
  baseAmountCents     Int
  dueDay              Int
  gracePeriodDays     Int      @default(1)
  initialLateFeeCents Int      @default(0)
  dailyLateFeeCents   Int      @default(0)
  dailyLateFeeMaxDays Int      @default(0)
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  charges  RecurringCharge[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, isActive])
}

model RecurringCharge {
  id                    String   @id @default(cuid())
  recurringPlanId       String
  sharedChargeGroupId   String?
  label                 String
  amountCents           Int
  effectiveBillingCycle String?
  endsAfterBillingCycle String?
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recurringPlan RecurringPlan @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)

  @@index([recurringPlanId, isActive])
  @@index([recurringPlanId, sortOrder])
  @@index([sharedChargeGroupId])
  @@index([effectiveBillingCycle])
  @@index([endsAfterBillingCycle])
}

model OneTimeCharge {
  id         String @id @default(cuid())
  businessId String

  unitNumber           String
  normalizedUnitNumber String

  label       String
  amountCents Int

  status OneTimeChargeStatus @default(PENDING)

  paymentId   String?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, normalizedUnitNumber, status])
  @@index([paymentId])
}

model Payment {
  id         String            @id @default(cuid())
  businessId String
  sourceType PaymentSourceType
  sourceId   String?

  status        PaymentStatus  @default(CREATED)
  paymentMethod PaymentMethod?

  payerFirstName String
  payerLastName  String
  payerPhone     String
  payerEmail     String?
  referenceLabel String?

  itemDescription       String
  lineItemsSnapshot     Json
  subtotalCents         Int
  platformFeeCents      Int
  processorFeeCents     Int?
  totalChargedCents     Int
  businessProceedsCents Int?

  billingCycle String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String? @unique

  checkoutStartedAt DateTime?
  pendingAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  expiredAt         DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  returnedAt        DateTime?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  smsReceipt     SmsReceipt?
  oneTimeCharges OneTimeCharge[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, billingCycle])
  @@index([businessId, sourceType, sourceId])
  @@index([status, createdAt])
}

model SmsReceipt {
  id                String           @id @default(cuid())
  paymentId         String           @unique
  phone             String
  status            SmsReceiptStatus @default(QUEUED)
  providerMessageId String?          @unique
  failureMessage    String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VerificationToken {
  id         String                @id @default(cuid())
  businessId String
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type])
  @@index([expiresAt])
  @@index([type, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorType  String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  type      SessionType

  businessId    String?
  managerId     String?
  adminAccessId String?

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager     Manager?     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  adminAccess AdminAccess? @relation(fields: [adminAccessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([managerId])
  @@index([adminAccessId])
  @@index([type, expiresAt])
  @@index([expiresAt])
}
