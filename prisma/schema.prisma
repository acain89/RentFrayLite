generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessMode {
  RECURRING
  PRODUCTS_SERVICES
  CUSTOM
}

enum BusinessStatus {
  SETUP
  ACTIVE
  DISABLED
}

enum PaymentStatus {
  CREATED
  CHECKOUT_STARTED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  DISPUTED
  RETURNED
}

enum PaymentMethod {
  ACH
  CARD
}

enum PaymentSourceType {
  RECURRING_PLAN
  CATALOG_ITEM
  CUSTOM_POSTING
}

enum SessionType {
  MANAGER
  ADMIN
}

enum LateFeeType {
  NONE
  FLAT
}

enum CustomPostingStatus {
  ACTIVE
  CHECKOUT_STARTED
  COMPLETED
  EXPIRED
}

enum SmsReceiptStatus {
  QUEUED
  SENT
  FAILED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminAccess {
  id         String    @id @default(cuid())
  codeHash   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sessions Session[]

  @@index([isActive])
}

model Business {
  id                  String         @id @default(cuid())
  name                String
  accountCode         String?        @unique
  accountCodeLockedAt DateTime?
  mode                BusinessMode?
  status              BusinessStatus @default(SETUP)

  ownerName    String
  contactEmail String
  contactPhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  manager            Manager?
  stripeConnection   StripeConnection?
  recurringPlans     RecurringPlan[]
  catalogItems       CatalogItem[]
  customPostings     CustomPosting[]
  payments           Payment[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]
  sessions           Session[]

  @@index([status])
  @@index([mode])
  @@index([contactEmail])
  @@index([isActive])
}

model Manager {
  id           String    @id @default(cuid())
  businessId   String    @unique
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([email])
  @@index([isActive])
}

model StripeConnection {
  id                  String    @id @default(cuid())
  businessId          String    @unique
  stripeAccountId     String    @unique
  chargesEnabled      Boolean   @default(false)
  payoutsEnabled      Boolean   @default(false)
  onboardingComplete  Boolean   @default(false)
  requirementsDue     Boolean   @default(false)
  requirementsSummary String?
  readyForLive        Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([readyForLive])
  @@index([onboardingComplete])
}

model RecurringPlan {
  id                 String      @id @default(cuid())
  businessId         String
  name               String
  baseAmountCents    Int
  dueDay             Int
  gracePeriodDays    Int         @default(0)
  lateFeeType        LateFeeType @default(NONE)
  lateFeeAmountCents Int         @default(0)
  sortOrder          Int         @default(0)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  charges  RecurringCharge[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, isActive])
}

model RecurringCharge {
  id              String   @id @default(cuid())
  recurringPlanId String
  label           String
  amountCents     Int
  effectiveDate   DateTime
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recurringPlan RecurringPlan @relation(fields: [recurringPlanId], references: [id], onDelete: Cascade)

  @@index([recurringPlanId, isActive])
  @@index([recurringPlanId, effectiveDate])
  @@index([recurringPlanId, sortOrder])
}

model CatalogItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  priceCents  Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, isActive])
}

model CustomPosting {
  id          String              @id @default(cuid())
  businessId  String
  title       String
  description String?
  amountCents Int
  status      CustomPostingStatus @default(ACTIVE)
  expiresAt   DateTime
  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([businessId, status])
  @@index([businessId, expiresAt])
  @@index([status, expiresAt])
}

model Payment {
  id         String            @id @default(cuid())
  businessId String
  sourceType PaymentSourceType
  sourceId   String?

  customPostingId String?

  status        PaymentStatus  @default(CREATED)
  paymentMethod PaymentMethod?

  payerFirstName String
  payerLastName  String
  payerPhone     String
  payerEmail     String?
  referenceLabel String?

  itemDescription       String
  lineItemsSnapshot     Json
  subtotalCents         Int
  platformFeeCents      Int
  processorFeeCents     Int?
  totalChargedCents     Int
  businessProceedsCents Int?

  billingCycle String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String? @unique

  checkoutStartedAt DateTime?
  pendingAt         DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  expiredAt         DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  returnedAt        DateTime?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customPosting CustomPosting? @relation(fields: [customPostingId], references: [id], onDelete: SetNull)
  smsReceipt    SmsReceipt?

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, billingCycle])
  @@index([businessId, sourceType, sourceId])
  @@index([status, createdAt])
  @@index([customPostingId])
}

model SmsReceipt {
  id                String           @id @default(cuid())
  paymentId         String           @unique
  phone             String
  status            SmsReceiptStatus @default(QUEUED)
  providerMessageId String?          @unique
  failureMessage    String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VerificationToken {
  id         String                @id @default(cuid())
  businessId String
  type       VerificationTokenType
  tokenHash  String                @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type])
  @@index([expiresAt])
  @@index([type, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorType  String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  type      SessionType

  businessId    String?
  managerId     String?
  adminAccessId String?

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager     Manager?     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  adminAccess AdminAccess? @relation(fields: [adminAccessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([managerId])
  @@index([adminAccessId])
  @@index([type, expiresAt])
  @@index([expiresAt])
}
